uv.dll

# Model weights and checkpoints
checkpoints/
*.pth
*.h5
*.ckpt
*.weights

# Datasets, uploads, and runtime data
data/
dataset/
uploads/
*.log
feedback.json
users.json
app_errors.log

# Third-party source copies (install via pip instead)
modules/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS-specific
.DS_Store
Thumbs.db
desktop.ini

