*.py[cod]
*.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
.env
smart_sign_env/
unisign_env/

# Build, packaging, and compiled binaries
build/
dist/
main.spec
smart_sign.build/
smart_sign.dist/
main.build/
main.dist/
nuitka-crash-report.xml
*.build/
*.dist/
*.exe
*.dll
*.pyd
VC_redist.x64.exe
generated-*.ico
ffmpeg.exe
ffplay.exe
ffprobe.exe
c10.dll
libiomp5md.dll
libiompstubs5md.dll
